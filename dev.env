INPUT_DIR=/data/input
OUTPUT_DIR=/data/output
METHODS=pca,fa,gpfa,cebra
BEHAVIOR_VARS=auto
BIN_SIZE_S=0
SMOOTH_S=0.05
N_COMPONENTS=10
CV_FOLDS=5
GPFA_MAX_NEURONS=150
GPFA_BIN_S=0.05
GPFA_DIMS=3
# the fixture is small: few iterations (defaults GPFA 100, CEBRA 10000 gpu / 3000 cpu)
GPFA_ITERS=20
GPFA_SEGMENT_S=2.0
GPFA_MAX_SEGMENTS=150
TRIAL_ALIGN=auto
TRIAL_WINDOW_S=-0.2,1.0
CEBRA_ITERS=300
CEBRA_BATCH=256
CEBRA_DIMS=3
CEBRA_ARCH=offset10-model
CEBRA_LR=0.0003
CEBRA_TEMPERATURE=1.0
TRAIN_FRACTION=0.8
MAX_PLOT_POINTS=20000
SEED=42
THREADS=0
USE_GPU=auto
